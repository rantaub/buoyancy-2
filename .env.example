# ─────────────────────────────────────────────────────────────
# MARKETING AUTOMATION AGENT — Environment Variables
# Copy this file to .env and fill in the keys you want to use.
# Channels without keys run in DRY RUN mode (saves to files).
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── EMAIL (SendGrid) ──────────────────────────────────────────
# Get a free key at https://sendgrid.com
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=hello@yourdomain.com
SENDGRID_TO_EMAIL=subscriber@example.com   # or your list ID

# ── TWITTER / X ───────────────────────────────────────────────
# Create an app at https://developer.twitter.com
# Requires OAuth 1.0a "Read and Write" access
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Optional: also install oauth-1.0a (npm install oauth-1.0a)

# ── LINKEDIN ──────────────────────────────────────────────────
# OAuth 2.0 access token from https://developer.linkedin.com
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=urn:li:person:XXXXXXXX   # your LinkedIn person URN

# ── FACEBOOK ──────────────────────────────────────────────────
# Page Access Token from https://developers.facebook.com
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── INSTAGRAM ─────────────────────────────────────────────────
# Instagram Graph API (requires Facebook Business account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEFAULT_IMAGE_URL=https://yourcdn.com/default-image.jpg

# ── DISCORD ───────────────────────────────────────────────────
# Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ── SLACK ─────────────────────────────────────────────────────
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── WORDPRESS (Blog) ──────────────────────────────────────────
# Settings → Application Passwords
WORDPRESS_API_URL=https://your-blog.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── SMS (Twilio) ──────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX   # for testing; use list service in prod

# ── Google Ads & YouTube ──────────────────────────────────────
# These channels always save files locally (no API key needed for content generation)
# Paste the generated copy into Google Ads Manager / YouTube Studio
